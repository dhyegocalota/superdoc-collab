{
  "name": "superdoc-history",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@8.15.9",
  "engines": { "node": ">=24" },
  "pnpm": { "neverBuiltDependencies": ["better-sqlite3"] },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p e2e --noEmit",
    "test:unit": "pnpm -r test:unit && pnpm test:hooks",
    "test:hooks": "bash .agents/hooks/hooks.test.sh",
    "test:e2e": "playwright test",
    "seed": "pnpm --filter @superdoc-history/server seed",
    "verify": "pnpm typecheck && pnpm test:unit && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "better-sqlite3": "13.0.3",
    "typescript": "7.0.2"
  }
}
