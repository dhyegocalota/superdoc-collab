# Local values work as they are. Production values live in the Railway service variables (docs/features/deploy/runbook-railway.md); docker/docker-compose.yml pins PORT, DATABASE_DIR, WEB_DIST_DIR and TRUST_PROXY
PORT=3000
# Optional: the address to bind. Empty or unset binds every interface, which the container needs behind its proxy; the test stacks set 127.0.0.1
HOST=
# Production: https://<your domain>, a bare origin with no path and no trailing slash
APP_ORIGIN=http://localhost:5173
# Secret. Production: a fresh value from `openssl rand -base64 48`; this placeholder is public and must never reach a deploy
AUTH_SECRET=change-me-32-characters-minimum-secret
DATABASE_DIR=./data
# Tests only: the password of the seeded demo accounts. Production does not read it
DEMO_PASSWORD=superdoc-demo
# NB ADR 0042: set TRUST_PROXY=true only behind a reverse proxy that sets X-Forwarded-For (Railway); the address is the entry that proxy added, counted from the right; keep false for local runs
TRUST_PROXY=false
# Optional: trusted proxies in front of the app, counted from the right of X-Forwarded-For (default 1; Railway alone is 1)
TRUSTED_PROXY_HOPS=
# Tests only, exactly true or false. Production: false; true seeds the demo accounts and a test administrator on start and requires DEMO_PASSWORD (ADR 0020)
SEED_DEMO_USERS=false
# NB: LLM access goes through OpenRouter (owner decision); the model id is configurable
# Secret. Production: the owner's key, set only in the Railway service variables; empty keeps the app running without topics and summaries
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-6-luna
# Empty in production; tests point it at a fake
OPENROUTER_BASE_URL=
# Optional: process-wide cap on LLM jobs running at once (default 2)
LLM_MAX_CONCURRENT_JOBS=
# Optional: process-wide cap on model calls per rolling hour (default 60)
LLM_MAX_CALLS_PER_HOUR=
# Optional: documents one user may open for the first time per rolling minute (default 30)
OPEN_UNCOMMITTED_PER_MINUTE=
# Optional: uploads and blank creates one user may make per rolling minute (default 30)
UPLOADS_PER_MINUTE=
# Optional: longest predicted wait in milliseconds for a heavy upload before the server answers 503 (default 300000)
MAX_BOOTSTRAP_WAIT_MS=
# Optional: milliseconds an AI stays in the members row after its last tool call (default 60000)
AGENT_PRESENCE_LINGER_MS=
# Optional: megabytes of server heap the loaded heavy rooms may use; unset derives it from the memory limit and the server heap
ROOM_HEAP_BUDGET_MEGABYTES=
# Optional: heavy documents one user may upload per rolling hour (default 6)
MAX_HEAVY_CONVERSIONS_PER_HOUR=
# Optional: old-generation heap cap in megabytes for the projection worker thread; docker/entrypoint.sh sets it to half of the container memory limit; unset keeps Node's default
PROJECTION_WORKER_HEAP_MEGABYTES=
# Optional: memory in megabytes the collector of each SDK host is sized for (a Bun runtime setting, not a hard cap); docker/entrypoint.sh sets it to 20% of the container memory limit; unset leaves the host unsized
BOOTSTRAP_HOST_HEAP_MEGABYTES=
# Optional: memory limit of the container in megabytes; docker/entrypoint.sh sets it from the cgroup limit; the server refuses an upload whose bootstrap would not fit; unset means unknown and nothing is refused for memory
MEMORY_LIMIT_MEGABYTES=
